{
  "name": "packy-workspace",
  "private": true,
  "workspaces": [
    "apps/desktop",
    "web/admin"
  ],
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "types": "cargo run --locked -p packy-common --example export_types",
    "build": "npm run types && npm run build --workspace @packy/desktop && npm run build --workspace @packy/admin",
    "check": "npm run check --workspaces",
    "desktop": "npm run tauri --workspace @packy/desktop -- dev",
    "format": "prettier --write \"apps/desktop/src/**/*.{ts,vue}\" \"web/admin/src/**/*.{ts,vue}\" \"web/shared/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"apps/desktop/src/**/*.{ts,vue}\" \"web/admin/src/**/*.{ts,vue}\" \"web/shared/*.{ts,vue,css}\"",
    "desktop:build": "node scripts/build-desktop.mjs",
    "test:build": "node --test scripts/build-desktop.test.mjs scripts/build-release.test.mjs",
    "release:build": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vue-tsc": "3.3.13",
    "yaml": "2.9.1"
  }
}
