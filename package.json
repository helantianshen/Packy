{
  "name": "packy-workspace",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm --prefix web/admin run build && npm --prefix web/desktop run build",
    "check": "npm --prefix web/admin run type:check && npm --prefix web/desktop run check",
    "test": "go test ./cmd/... ./internal/... ./pkg/... ./config/...",
    "desktop:build": "node scripts/build-desktop.mjs",
    "server:build": "node scripts/build-server.mjs",
    "test:smoke": "node scripts/smoke.mjs && node scripts/tests/server-shutdown.mjs",
    "format:check": "prettier --check web/desktop/src web/desktop/electron scripts",
    "release": "node scripts/release.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  }
}
