{
  "name": "packy-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Packy 整合包更新器",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron ."
  },
  "dependencies": {
    "@lucide/vue": "^1.59.0",
    "electron-log": "5.4.4",
    "image-size": "2.0.4",
    "motion-v": "^1.7.1",
    "vscode-jsonrpc": "^8.2.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.7.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^44.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.0"
  }
}
